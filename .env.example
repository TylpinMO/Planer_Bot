# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# Database Configuration
# SQLite (локальный запуск)
DATABASE_URL=sqlite+aiosqlite:///./planner.db

# PostgreSQL (альтернативный вариант; отдельно проверьте миграции и запуск)
# Раскомментируйте и настройте при необходимости:
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/plannerbot

# Premium Settings
PREMIUM_PRICE_STARS=250
