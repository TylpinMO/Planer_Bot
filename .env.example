# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# Database Configuration
# SQLite (для разработки и небольших проектов до 500 пользователей)
DATABASE_URL=sqlite+aiosqlite:///./planner.db

# PostgreSQL (для production при >500 активных пользователей)
# Раскомментируйте и настройте при необходимости:
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/plannerbot

# Premium Settings
PREMIUM_PRICE_STARS=250
